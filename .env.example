# Copy this file to .env and fill in your real keys.

# OKX testnet keys
OKX_API_KEY=YOUR_OKX_TESTNET_API_KEY
OKX_SECRET_KEY=YOUR_OKX_TESTNET_SECRET_KEY
OKX_PASSPHRASE=YOUR_OKX_TESTNET_PASSPHRASE
OKX_TESTNET=true

# LLM provider. It is only used for loss reviews, not real-time entry decisions.
# Any OpenAI-compatible third-party endpoint should work.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_MODEL=gpt-4.1-mini

# Optional proxy
HTTP_PROXY_URL=http://127.0.0.1:7890
HTTPS_PROXY_URL=http://127.0.0.1:7890

# Optional external data APIs
CRYPTOPANIC_TOKEN=
COINGECKO_DEMO_KEY=
